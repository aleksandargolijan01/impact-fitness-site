{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index*.html",
          "/manifest.webmanifest",
          "/offline.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/robots.txt", "/sitemap.xml"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-fonts",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "30d",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "remote-images",
      "urls": ["https://images.unsplash.com/**"],
      "cacheConfig": {
        "maxSize": 40,
        "maxAge": "14d",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "firebase-data",
      "urls": [
        "https://firestore.googleapis.com/**",
        "https://identitytoolkit.googleapis.com/**",
        "https://securetoken.googleapis.com/**"
      ],
      "cacheConfig": {
        "maxSize": 40,
        "maxAge": "1h",
        "timeout": "8s",
        "strategy": "freshness"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/offline.html"]
}
